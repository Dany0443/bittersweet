  "watched": [
    {
      "name": "Palmwave",
      "note": "PalmwaveWas a fork of XCL, then from 21:12\u00a0UTC on 24 November a renamed copy of victory-fork with a few commits of its own. Its repository stopped answering at about 22:15\u00a0UTC, with no published takedown notice naming it and the reason not known.",
      "online": false,
      "repo": null,
      "url": null
    },
    {
      "name": "project-flamingo",
      "note": "A fork of VIctory with its own pull-request queue, which Scarlight's README points NVIDIA and Windows users to. Its README still carries VIctory's status from 23 November and reports no results of its own.",
      "online": true,
      "repo": "JMAN730/project-flamingo",
      "url": "https://github.com/JMAN730/project-flamingo"
    },
    {
      "name": "G6Recomp",
      "note": "Now creates the game's window, graphics device, command queues and lists, with memory code ported from Leonida. No frame yet.",
      "online": true,
      "repo": "Kajcsi/G6Recomp",
      "url": "https://github.com/Kajcsi/G6Recomp"
    },
    {
      "name": "XValkyrie",
      "note": "Runs other Xbox Series games and has published work on a later title's first frames, without naming it. It bundled a copy of the VIctory engine for about 20\u00a0minutes on 24 November, removed it, and now ports parts of VIctory's texture code with credit.",
      "online": true,
      "repo": "sammwyy/xvalkyrie",
      "url": "https://github.com/sammwyy/xvalkyrie"
    },
    {
      "name": "AnyPS5",
      "note": "The PlayStation route. Blocked: no PS5 build of the game is public.",
      "online": true,
      "repo": "boykopovar/AnyPS5",
      "url": "https://github.com/boykopovar/AnyPS5"
    },
    {
      "name": "XSXEmu",
      "note": "A Rust emulator for Xbox Series titles on Apple Silicon that does not use Wine. Its README now says the game's own code starts under Rosetta and opens its archives, and that it has not yet created a graphics device, run a shader or produced a frame.",
      "online": true,
      "repo": "daeken/XSXEmu",
      "url": "https://github.com/daeken/XSXEmu"
    },
    {
      "name": "Xenstride",
      "note": "A derivative of XCL that changes how graphics pipelines are scheduled and built ahead of time. Its status page says gameplay is not demonstrated: its tests run on a software renderer or synthetic inputs, and a newer retail title's world load still ends in the game's own watchdog.",
      "online": true,
      "repo": "mkr2tl/xenstride-public",
      "url": "https://github.com/mkr2tl/xenstride-public"
    },
    {
      "name": "gta-vi-astral",
      "note": "A system written in Go and documented in French. Its README now says the intro screens' interface draws on a graphics card at 30\u00a0frames a second in runs of 65\u00a0seconds without a crash, with navigable menus in progress and no 3D picture or sound yet, and calls it not playable.",
      "online": true,
      "repo": "Archivist-Atlas/gta-vi-astral",
      "url": "https://github.com/Archivist-Atlas/gta-vi-astral"
    },
    {
      "name": "victory-world-runtime",
      "note": "A fork of VIctory that gathers fixes from the public forks, and the base DexNom Runtime builds on. Its README still carries victory-fork's earlier status and reports no results of its own.",
      "online": true,
      "repo": "ZSlayerHQ/victory-world-runtime",
      "url": "https://github.com/ZSlayerHQ/victory-world-runtime"
    }
  ]
}
